<Project Sdk="Microsoft.NET.Sdk">

  <!--
    [ARCH] Application livrée = ZÉRO PackageReference. Tout vient du SDK .NET
    (WPF, WinForms, System.Text.Json, interop Win32). Réf : ARCHI-DOTNET-WPF.md.
    Les propriétés TFM/Nullable/UseWPF/UseWindowsForms + publication sont dans
    Directory.Build.props (racine).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Resources/app.ico</ApplicationIcon>
    <!-- [DECISION] Namespace racine DofusSwitcher : évite le conflit namespace==classe App qui casse le
         point d'entrée WPF généré. L'AssemblyName (nom de l'exe) est indépendant du RootNamespace :
         l'exécutable publié est DofusOptimizer.exe (Axe 9), sans réintroduire ce conflit. -->
    <RootNamespace>DofusSwitcher</RootNamespace>
    <AssemblyName>DofusOptimizer</AssemblyName>
    <!-- Version applicative (affichée dans l'à-propos via Assembly.GetName().Version). -->
    <Version>1.1.0</Version>
    <!-- [DECISION] Axe 3 : requis pour les pointeurs de fonction (delegate* unmanaged) et les
         callbacks [UnmanagedCallersOnly] de la détection. [LibraryImport] ne marshale pas les
         délégués (SYSLIB1051) ; les pointeurs de fonction sont la voie compatible source-gen.
         Portée limitée à l'app (pas dans Directory.Build.props) : les tests restent sans unsafe.
         Ce n'est pas une propriété de publication : hors périmètre « ne pas modifier ». -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icône embarquée en ressource : réutilisée par la fenêtre et le NotifyIcon (tray, Axe 7). -->
    <Resource Include="Resources/app.ico" />
  </ItemGroup>

</Project>
