<UserControl x:Class="DofusSwitcher.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <!--
        Onglet Comptes v2 (spec comptes-v2 §2.6) : 3 zones.
        1. Comptes connectés (compte + personnage connecté en sous-titre) — en haut, ordre de rotation.
        2. Personnages connectés sans compte — avec liaison à un compte disponible.
        3. Comptes déconnectés ayant des personnages liés — collés en bas.
        [DECISION] Le glisser-déposer de réordonnancement (v1) n'est pas exposé ici : la vue est
        organisée par compte, pas en liste de rotation unique. La rotation reste sur l'ordre persisté.
        [ARCH] Aucune valeur HEX ici : uniquement des brushes de Colors.xaml.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Icônes œil (visible / barré = exclu de la rotation). -->
        <Geometry x:Key="EyeOpenGeometry">M8,4 C13,4 16,8 16,8 C16,8 13,12 8,12 C3,12 0,8 0,8 C0,8 3,4 8,4 Z M8,5.5 A2.5,2.5 0 1 0 8,10.5 A2.5,2.5 0 1 0 8,5.5 Z</Geometry>
        <Geometry x:Key="EyeClosedGeometry">M8,4 C13,4 16,8 16,8 C16,8 13,12 8,12 C3,12 0,8 0,8 C0,8 3,4 8,4 Z M8,5.5 A2.5,2.5 0 1 0 8,10.5 A2.5,2.5 0 1 0 8,5.5 Z M1,1 L15,15</Geometry>

        <!-- Bouton œil (exclure / réintégrer le personnage). -->
        <Style x:Key="EyeButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton d'action sobre (Lier). -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SurfaceAltBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Élément de liste déroulante (compte) — thème sombre. -->
        <Style x:Key="AccountComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox de liaison (compte disponible) — thème sombre complet (champ + liste déroulante). -->
        <Style x:Key="AccountComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource AccountComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource SurfaceAltBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="8,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="&#9662;" Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              TextElement.Foreground="{StaticResource TextPrimaryBrush}"
                                              Margin="9,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource SurfaceAltBrush}" BorderThickness="1"
                                        CornerRadius="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="200"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Carte de ligne (compte/personnage). -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- En-tête de zone. -->
        <Style x:Key="ZoneHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>

        <!-- Zone 1 : compte connecté + personnage connecté en sous-titre. Réordonnable par glisser-déposer
             (poignée ☰) : l'ordre = ordre de rotation, persisté même pour les personnages absents. -->
        <DataTemplate x:Key="ConnectedAccountTemplate">
            <Border Style="{StaticResource CardBorderStyle}" AllowDrop="True" Drop="Row_Drop">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#9776;" Margin="0,0,10,0" VerticalAlignment="Center"
                               Cursor="SizeAll" ToolTip="Glisser pour réordonner la rotation"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               PreviewMouseLeftButtonDown="Handle_PreviewMouseLeftButtonDown"
                               PreviewMouseMove="Handle_PreviewMouseMove" />
                    <StackPanel Grid.Column="1" x:Name="Texts" VerticalAlignment="Center">
                        <TextBlock x:Name="CharName" Text="{Binding Character.CharacterName}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding AccountName}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" FontSize="20"
                               Text="&#9679;" ToolTip="Connecté" Foreground="{StaticResource SuccessBrush}" />
                    <Button Grid.Column="3" Style="{StaticResource EyeButtonStyle}"
                            ToolTip="Exclure de la rotation"
                            Command="{Binding DataContext.ToggleExcludeItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Character}">
                        <Path x:Name="Eye" Data="{StaticResource EyeOpenGeometry}" Width="20" Height="14"
                              Stretch="Uniform" Fill="{x:Null}" Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1" StrokeLineJoin="Round" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Character.IsExcluded}" Value="True">
                    <Setter TargetName="Texts" Property="Opacity" Value="0.5" />
                    <Setter TargetName="CharName" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="Eye" Property="Data" Value="{StaticResource EyeClosedGeometry}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Zone 2 : personnage connecté sans compte + liaison. -->
        <DataTemplate x:Key="UnlinkedCharacterTemplate">
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13"
                               Text="{Binding Character.CharacterName}" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ComboBox Grid.Column="1" Style="{StaticResource AccountComboBoxStyle}"
                              ItemsSource="{Binding AvailableAccounts}"
                              SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                              ToolTip="Compte à rattacher (seuls les comptes disponibles sont proposés)" />
                    <Button Grid.Column="2" Style="{StaticResource ActionButtonStyle}"
                            Content="Lier" Command="{Binding LinkCommand}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Zone 3 : compte déconnecté (nom seul, sans personnage). -->
        <DataTemplate x:Key="DisconnectedAccountTemplate">
            <Border Style="{StaticResource CardBorderStyle}" Opacity="0.6">
                <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Zones 1 & 2 : haut de page, défilables. -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Visibility="{Binding HasConnected, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Comptes connectés" Style="{StaticResource ZoneHeaderStyle}" />
                    <ItemsControl ItemsSource="{Binding ConnectedAccounts}"
                                  ItemTemplate="{StaticResource ConnectedAccountTemplate}" />
                </StackPanel>

                <StackPanel Margin="0,6,0,0"
                            Visibility="{Binding HasUnlinked, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Personnages sans compte" Style="{StaticResource ZoneHeaderStyle}" />
                    <ItemsControl ItemsSource="{Binding UnlinkedConnected}"
                                  ItemTemplate="{StaticResource UnlinkedCharacterTemplate}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Zone 3 : comptes déconnectés, collés en bas. -->
        <StackPanel Grid.Row="1" Margin="0,10,0,0"
                    Visibility="{Binding HasDisconnected, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Comptes déconnectés" Style="{StaticResource ZoneHeaderStyle}" />
            <ItemsControl ItemsSource="{Binding DisconnectedAccounts}"
                          ItemTemplate="{StaticResource DisconnectedAccountTemplate}"
                          MaxHeight="180">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
            </ItemsControl>
        </StackPanel>

        <!-- État vide : aucun personnage détecté ni persisté. -->
        <TextBlock Grid.Row="0" Grid.RowSpan="2"
                   Text="Aucun client DOFUS détecté. Ouvrez un client : il apparaîtra ici automatiquement."
                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
