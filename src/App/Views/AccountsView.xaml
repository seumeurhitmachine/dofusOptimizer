<UserControl x:Class="DofusSwitcher.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <!--
        Onglet Comptes (Axe 10, [DT-029]) : liste unifiée de rotation + comptes déconnectés.
        - Connectés : une seule liste ordonnée (= ordre de rotation) de personnages connectés, liés à un
          compte OU non. Toute ligne : glisser-déposer (poignée ☰), exclusion (œil), fermeture (croix) ;
          une ligne non liée ajoute le combo des comptes disponibles + « Lier ». Les personnages sans
          compte sont des participants de plein droit (revient sur la ségrégation par zone de l'Axe 8).
        - Comptes déconnectés (personnages liés tous absents) — collés en bas.
        [ARCH] Aucune valeur HEX ici : uniquement des brushes de Colors.xaml.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Bouton d'exclusion / réintégration du personnage (croix grise ↔ plus). -->
        <Style x:Key="EyeButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="6,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icône marche/arrêt (fermeture du client, Axe 9) : anneau ouvert en haut + trait vertical. -->
        <Geometry x:Key="PowerGeometry">M8,1.5 L8,8 M4.9,4.1 A5,5 0 1 0 11.1,4.1</Geometry>

        <!-- Icônes d'exclusion / réintégration : croix grise (exclure) ↔ plus (réintégrer). -->
        <Geometry x:Key="ExcludeCrossGeometry">M0,0 L10,10 M10,0 L0,10</Geometry>
        <Geometry x:Key="ReintegratePlusGeometry">M5,0 L5,10 M0,5 L10,5</Geometry>

        <!-- Couronne (chef, Axe 13) : indicateur à droite du nom du personnage du compte chef. -->
        <Geometry x:Key="CrownGeometry">M1,12 L1,5 L5,8 L8,3 L11,8 L15,5 L15,12 Z</Geometry>
        <!-- « Personne + » (chef, Axe 13) : bouton de copie des /invite (tête + épaules + plus). -->
        <Geometry x:Key="PersonPlusGeometry">M6,2 A2,2 0 1 1 5.99,2 M2,13 C2,9.5 10,9.5 10,13 M13,5 L13,11 M10,8 L16,8</Geometry>

        <!-- Bouton marche/arrêt rouge par ligne connectée (ferme le client). -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="ToolTip" Value="Fermer le client" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="6,4">
                            <Path x:Name="Power" Data="{StaticResource PowerGeometry}" Width="14" Height="14"
                                  Stretch="Uniform" Fill="{x:Null}" Stroke="{StaticResource ErrorBrush}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ErrorBrush}" />
                                <Setter TargetName="Power" Property="Stroke" Value="{StaticResource TextOnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton « Terminer session » : contour rouge, se remplit au survol. -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent"
                                BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ErrorBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gros CTA accent « Ouvrir une session » (fond accent, texte blanc). -->
        <Style x:Key="PrimaryCtaButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{StaticResource PrimaryBrush}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton d'action sobre (Lier). -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SurfaceAltBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Élément de liste déroulante (compte) — thème sombre. -->
        <Style x:Key="AccountComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox de liaison (compte disponible) — thème sombre complet (champ + liste déroulante). -->
        <Style x:Key="AccountComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource AccountComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource SurfaceAltBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="8,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="&#9662;" Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              TextElement.Foreground="{StaticResource TextPrimaryBrush}"
                                              Margin="9,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <!-- Invite par défaut (non sélectionnable) tant qu'aucun compte n'est choisi. -->
                            <TextBlock x:Name="Placeholder" Text="+ Compte" IsHitTestVisible="False"
                                       Margin="9,0,26,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource SurfaceAltBrush}" BorderThickness="1"
                                        CornerRadius="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="200"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Aucun compte sélectionné (SelectedIndex -1) → afficher l'invite « + Compte ». -->
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Carte de ligne (compte/personnage). -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- En-tête de zone. -->
        <Style x:Key="ZoneHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>

        <!-- Ligne connectée unifiée (Axe 10) : personnage connecté, lié à un compte OU non. Toute ligne est
             réordonnable par glisser-déposer (poignée ☰ ; l'ordre = ordre de rotation, persisté même absent),
             exclu(e)/réintégrable (œil) et fermable (croix). Une ligne NON liée expose en plus le combo des
             comptes disponibles + « Lier » (masqué tant qu'aucun compte n'est choisi). -->
        <DataTemplate x:Key="ConnectedRowTemplate">
            <Border x:Name="Card" Style="{StaticResource CardBorderStyle}"
                    AllowDrop="True" DragOver="Row_DragOver" Drop="Row_Drop">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Fond transparent + padding : agrandit la zone de préhension du glisser-déposer
                         (les événements souris ne se déclenchent que sur une surface non nulle). -->
                    <TextBlock x:Name="DragHandle" Grid.Column="0" Text="&#9776;" Margin="0,0,4,0" Padding="8,10" VerticalAlignment="Center"
                               FontSize="15" Background="Transparent"
                               Cursor="SizeAll" ToolTip="Glisser pour réordonner la rotation"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               PreviewMouseLeftButtonDown="Handle_PreviewMouseLeftButtonDown"
                               PreviewMouseMove="Handle_PreviewMouseMove" />
                    <StackPanel Grid.Column="1" x:Name="Texts" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CharName" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <!-- Couronne (chef, Axe 13) : indicateur à droite du nom, visible seulement pour le chef. -->
                            <Path x:Name="ChefCrown" Data="{StaticResource CrownGeometry}" Width="13" Height="11"
                                  Margin="6,0,0,0" VerticalAlignment="Center" Stretch="Uniform"
                                  Fill="{StaticResource PrimaryBrush}" Stroke="{StaticResource PrimaryBrush}"
                                  StrokeThickness="1" StrokeLineJoin="Round"
                                  ToolTip="Compte chef"
                                  Visibility="{Binding IsChef, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <!-- Sous-titre = nom du compte : visible seulement pour une ligne liée. -->
                        <TextBlock x:Name="AccountSubtitle" Text="{Binding AccountName}" FontSize="11"
                                   Visibility="Collapsed" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <!-- Liaison (lignes non liées uniquement). -->
                    <ComboBox x:Name="LinkCombo" Grid.Column="2" Style="{StaticResource AccountComboBoxStyle}"
                              Visibility="Collapsed"
                              ItemsSource="{Binding AvailableAccounts}"
                              SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                              ToolTip="Compte à rattacher (seuls les comptes disponibles sont proposés)" />
                    <Button x:Name="LinkBtn" Grid.Column="3" Style="{StaticResource ActionButtonStyle}"
                            Content="Lier" Visibility="Collapsed" Command="{Binding LinkCommand}" />
                    <!-- Léger séparateur vertical entre la zone liaison et les actions (+/X). -->
                    <Border x:Name="Separator" Grid.Column="4" Width="1" Margin="8,3" VerticalAlignment="Stretch"
                            Background="{StaticResource SurfaceAltBrush}" />
                    <Button x:Name="ExcludeBtn" Grid.Column="5" Style="{StaticResource EyeButtonStyle}"
                            ToolTip="Exclure de la rotation"
                            Command="{Binding DataContext.ToggleExcludeItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Character}">
                        <Path x:Name="ExcludeIcon" Data="{StaticResource ExcludeCrossGeometry}" Width="12" Height="12"
                              Stretch="Uniform" Fill="{x:Null}" Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <!-- Retour informatif « Copié ! » (chef, Axe 13) : apparaît brièvement après la copie des
                         /invite puis s'efface seul (aucun clic requis). Réservé à la ligne chef, transparent au repos. -->
                    <TextBlock x:Name="CopiedHint" Grid.Column="6" Text="Copié !" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,4,0" Opacity="0" IsHitTestVisible="False"
                               Foreground="{StaticResource PrimaryBrush}"
                               Visibility="{Binding ShowInvite, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Copier les /invite des autres personnages connectés (chef, Axe 13) : à gauche de la croix,
                         visible seulement sur la ligne chef quand au moins un autre perso est connecté. -->
                    <Button x:Name="InviteBtn" Grid.Column="7" Style="{StaticResource EyeButtonStyle}"
                            ToolTip="Copier la commande /invite des autres personnages connectés"
                            Visibility="Collapsed" Command="{Binding CopyInviteCommand}">
                        <Path Data="{StaticResource PersonPlusGeometry}" Width="15" Height="13"
                              Stretch="Uniform" Fill="{x:Null}" Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                        <Button.Triggers>
                            <!-- Retour visuel purement informatif : fondu d'apparition de « Copié ! » puis
                                 effacement automatique après ~2 s, sans aucune interaction supplémentaire. -->
                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard Storyboard.TargetName="CopiedHint"
                                                Storyboard.TargetProperty="Opacity">
                                        <DoubleAnimation From="0" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation To="0" BeginTime="0:0:2" Duration="0:0:0.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="8" Style="{StaticResource CloseButtonStyle}"
                            Command="{Binding DataContext.CloseClientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Character}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- Ligne liée : afficher le sous-titre compte ; masquer combo + « Lier ». -->
                <DataTrigger Binding="{Binding IsLinked}" Value="True">
                    <Setter TargetName="AccountSubtitle" Property="Visibility" Value="Visible" />
                    <Setter TargetName="LinkCombo" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <!-- Ligne non liée : afficher le combo de liaison. -->
                <DataTrigger Binding="{Binding IsLinked}" Value="False">
                    <Setter TargetName="LinkCombo" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Aucun compte disponible : pas de combo (rien à quoi lier) — prime sur la règle ci-dessus. -->
                <DataTrigger Binding="{Binding AvailableAccounts.Count}" Value="0">
                    <Setter TargetName="LinkCombo" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <!-- « Lier » visible seulement quand un compte est sélectionné (Axe 10) — implique non liée. -->
                <DataTrigger Binding="{Binding CanLink}" Value="True">
                    <Setter TargetName="LinkBtn" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Bouton /invite visible sur la ligne chef quand au moins un autre perso est connecté (Axe 13). -->
                <DataTrigger Binding="{Binding ShowInvite}" Value="True">
                    <Setter TargetName="InviteBtn" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Client sans personnage (Axe 11) : rendu réduit — libellé « Dofus N » + croix seule. Pas de
                     poignée (non réordonnable), ni œil (non excluable), ni combo/« Lier » (pas de compte), ni
                     séparateur. Placé après les règles de liaison pour les neutraliser ([DT-030]). -->
                <DataTrigger Binding="{Binding IsAnonymous}" Value="True">
                    <Setter TargetName="DragHandle" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="LinkCombo" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="LinkBtn" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ExcludeBtn" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Character.IsExcluded}" Value="True">
                    <Setter TargetName="Texts" Property="Opacity" Value="0.5" />
                    <Setter TargetName="CharName" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="ExcludeBtn" Property="ToolTip" Value="Réintégrer dans la rotation" />
                    <Setter TargetName="ExcludeIcon" Property="Data" Value="{StaticResource ReintegratePlusGeometry}" />
                    <Setter TargetName="ExcludeIcon" Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
                <!-- Ligne glissée : prévisualisation « fantôme » (semi-transparente + contour accent) posée
                     à l'emplacement d'insertion, les autres lignes se décalant pour lui faire place. -->
                <DataTrigger Binding="{Binding Character.IsDragging}" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.4" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Zone du bas : compte déconnecté (nom seul, sans personnage). -->
        <DataTemplate x:Key="DisconnectedAccountTemplate">
            <Border Style="{StaticResource CardBorderStyle}" Opacity="0.6">
                <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ouvrir une session (Axe 9) : visible ssi aucun client connecté ET aucun launcher ouvert.
             Désactivé si le chemin du launcher est introuvable (OpenSessionCommand.CanExecute). -->
        <Button Grid.Row="0" Style="{StaticResource PrimaryCtaButtonStyle}" Content="Ouvrir une session"
                HorizontalAlignment="Stretch" Margin="0,4,0,10"
                Command="{Binding OpenSessionCommand}"
                ToolTip="Lance l'Ankama Launcher"
                Visibility="{Binding ShowOpenSession, Converter={StaticResource BoolToVisibility}}" />

        <!-- Liste unifiée des connectés (Axe 10) : haut de page, défilable. Ordre = ordre de rotation. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Visibility="{Binding HasConnected, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Connectés" Style="{StaticResource ZoneHeaderStyle}"
                               VerticalAlignment="Center" />
                    <!-- Terminer session : force-kill de tous les clients connectés puis fermeture de l'app. -->
                    <Button Grid.Column="1" Style="{StaticResource DangerButtonStyle}" Content="Terminer session"
                            Margin="0,0,2,6" ToolTip="Ferme tous les clients puis quitte Dofus Optimizer"
                            Command="{Binding EndSessionCommand}"
                            Visibility="{Binding HasConnectedClients, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ConnectedRows}"
                              ItemTemplate="{StaticResource ConnectedRowTemplate}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Zone du bas : comptes déconnectés, collés en bas. -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0"
                    Visibility="{Binding HasDisconnected, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Comptes déconnectés" Style="{StaticResource ZoneHeaderStyle}" />
            <ItemsControl ItemsSource="{Binding DisconnectedAccounts}"
                          ItemTemplate="{StaticResource DisconnectedAccountTemplate}"
                          MaxHeight="180">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
            </ItemsControl>
        </StackPanel>

        <!-- État vide : aucun personnage détecté ni persisté (sous le CTA « Ouvrir une session »). -->
        <TextBlock Grid.Row="1" Grid.RowSpan="2"
                   Text="Aucun client DOFUS détecté. Ouvrez un client : il apparaîtra ici automatiquement."
                   TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
