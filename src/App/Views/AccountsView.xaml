<UserControl x:Class="DofusSwitcher.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <!--
        Onglet Comptes (ui-design.md §Composants). Lecture seule à l'Axe 3 : liste temps réel avec
        état ; réordonnancement / exclusion arrivent à l'Axe 4.
        [ARCH] Aucune valeur HEX ici : uniquement des brushes de Colors.xaml. L'état n'est jamais
        porté par la seule couleur (pastille + libellé texte) — WCAG (ui-design §Contraintes).
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Ligne de compte : fond surface, survol surfaceAlt, coins arrondis. -->
        <Style x:Key="AccountRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SurfaceAltBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <!-- Liste des comptes (courte : nombre de clients, pas de pagination). -->
        <ListBox ItemsSource="{Binding Items}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource AccountRowStyle}"
                 Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Nom de personnage. -->
                        <TextBlock Grid.Column="0"
                                   Text="{Binding CharacterName}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" />

                        <!-- Badge « exclu » (warning), visible seulement si le compte est exclu. -->
                        <Border Grid.Column="1"
                                Margin="8,0"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                CornerRadius="3"
                                BorderThickness="1"
                                BorderBrush="{StaticResource WarningBrush}"
                                Visibility="{Binding IsExcluded, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="exclu"
                                       FontSize="10"
                                       Foreground="{StaticResource WarningBrush}" />
                        </Border>

                        <!-- État : pastille + libellé (jamais la couleur seule). -->
                        <TextBlock Grid.Column="2"
                                   x:Name="StateText"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Text="○ absent"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                            <Setter TargetName="StateText" Property="Text" Value="● connecté" />
                            <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- État vide : aucun compte persisté ni détecté. -->
        <TextBlock Text="Aucun client DOFUS détecté. Ouvrez un client : il apparaîtra ici automatiquement."
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
