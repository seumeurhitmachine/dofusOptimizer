<UserControl x:Class="DofusSwitcher.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <!--
        Onglet Comptes (ui-design.md §Composants/§Interactions). Liste temps réel avec état +
        réordonnancement (↑/↓ et glisser-déposer via la poignée ☰) + exclusion/réintégration.
        [ARCH] Aucune valeur HEX ici : uniquement des brushes de Colors.xaml. L'état n'est jamais
        porté par la seule couleur (pastille + libellé) — WCAG (ui-design §Contraintes).
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Bouton de toolbar : sobre, thème sombre. -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SurfaceAltBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ligne de compte : fond surface, survol surfaceAlt, coins arrondis. -->
        <Style x:Key="AccountRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource SurfaceAltBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Liste des comptes (courte : nombre de clients, pas de pagination). -->
        <ListBox x:Name="AccountsList"
                 Grid.Row="0"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 AllowDrop="True"
                 Drop="AccountsList_Drop"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource AccountRowStyle}"
                 Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Poignée de glisser-déposer (ui-design §Interactions). -->
                        <TextBlock Grid.Column="0"
                                   Text="&#9776;"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Cursor="SizeAll"
                                   ToolTip="Glisser pour réordonner"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   PreviewMouseLeftButtonDown="Handle_PreviewMouseLeftButtonDown"
                                   PreviewMouseMove="Handle_PreviewMouseMove" />

                        <!-- Nom de personnage. -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CharacterName}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" />

                        <!-- Badge « exclu » (warning), visible seulement si le compte est exclu. -->
                        <Border Grid.Column="2"
                                Margin="8,0"
                                Padding="5,1"
                                VerticalAlignment="Center"
                                CornerRadius="3"
                                BorderThickness="1"
                                BorderBrush="{StaticResource WarningBrush}"
                                Visibility="{Binding IsExcluded, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="exclu"
                                       FontSize="10"
                                       Foreground="{StaticResource WarningBrush}" />
                        </Border>

                        <!-- État : pastille + libellé (jamais la couleur seule). -->
                        <TextBlock Grid.Column="3"
                                   x:Name="StateText"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Text="&#9675; absent"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                            <Setter TargetName="StateText" Property="Text" Value="&#9679; connecté" />
                            <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- État vide : aucun compte persisté ni détecté. -->
        <TextBlock Grid.Row="0"
                   Text="Aucun client DOFUS détecté. Ouvrez un client : il apparaîtra ici automatiquement."
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <!-- Toolbar : réordonnancement + exclusion, sur le compte sélectionné. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="&#8593; Monter" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding MoveUpCommand}" />
            <Button Content="&#8595; Descendre" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding MoveDownCommand}" />
            <Button Content="Exclure / réintégrer" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ToggleExcludeCommand}" />
        </StackPanel>

        <!-- Aide : l'ordre de la liste = ordre de rotation. -->
        <TextBlock Grid.Row="2"
                   Margin="0,10,0,0"
                   Text="Ordre de la liste = ordre de rotation. Glisser ☰ ou utiliser ↑/↓. Comptes absents/exclus ignorés par « suivant/précédent ». Sauvegarde automatique."
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="11" />
    </Grid>
</UserControl>
