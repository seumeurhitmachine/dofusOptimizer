<Window x:Class="DofusSwitcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DofusSwitcher.Views"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="420" Width="480"
        MinHeight="360" MinWidth="420"
        WindowStartupLocation="CenterScreen">

    <!-- Shell à onglets (ui-design.md §Navigation). Comptes (Axe 3) + Raccourcis (Axe 5) + Réglages (Axe 7). -->
    <TabControl SelectionChanged="OnTabChanged">
        <TabItem Header="Comptes">
            <views:AccountsView DataContext="{Binding Accounts}" />
        </TabItem>
        <TabItem Header="Raccourcis">
            <views:ShortcutsView DataContext="{Binding Shortcuts}" />
        </TabItem>
        <TabItem x:Name="ReglagesTab" Header="Réglages">
            <views:ReglagesView DataContext="{Binding Settings}" />
        </TabItem>
    </TabControl>

</Window>
