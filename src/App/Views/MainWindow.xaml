<Window x:Class="DofusSwitcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DofusSwitcher.Views"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Icon="/Resources/app.ico"
        Height="420" Width="480"
        MinHeight="360" MinWidth="420"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <!-- Chrome personnalisé (Axe polish) : on supprime le bandeau/contour Windows et on redessine un bandeau
         sombre intégré (nom centré + 3 boutons). WindowChrome conserve le redimensionnement, l'accroche Aero
         et l'agrandissement corrects malgré WindowStyle=None. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Icônes de bandeau en vecteur (Path) plutôt qu'en police d'icônes : la police « Segoe MDL2 Assets »
             ne se résolvait pas ici (glyphes affichés en carrés). Le vectoriel s'affiche partout. -->
        <Geometry x:Key="CaptionMinimizeGeometry">M0,5 L10,5</Geometry>
        <Geometry x:Key="CaptionMaximizeGeometry">M0,0 L10,0 L10,10 L0,10 Z</Geometry>
        <Geometry x:Key="CaptionRestoreGeometry">M2,2 L2,0 L10,0 L10,8 L8,8 M0,2 L8,2 L8,10 L0,10 Z</Geometry>
        <Geometry x:Key="CaptionCloseGeometry">M0,0 L10,10 M10,0 L0,10</Geometry>

        <!-- Bouton de bandeau (réduire / agrandir) : sobre, survol surfaceAlt. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton fermer : survol rouge (destructif). -->
        <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource ErrorBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Contour discret de la fenêtre (remplace le cadre Windows retiré). -->
    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource SurfaceAltBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Bandeau sombre : logo + nom de l'appli centrés + boutons fenêtre intégrés à droite.
                 Trait clair en bas pour séparer le bandeau du menu à onglets. -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Colonne 0 : logo + nom centrés (span sur les 2 colonnes pour un centrage sur toute la largeur). -->
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Resources/logo.png" Width="20" Height="20" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>
                    <!-- Colonne 1 : boutons fenêtre, à droite, cliquables dans la zone caption. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                                ToolTip="Réduire" Click="MinimizeButton_Click">
                            <Path Data="{StaticResource CaptionMinimizeGeometry}" Width="10" Height="10"
                                  Stretch="None" StrokeThickness="1"
                                  Stroke="{StaticResource TextPrimaryBrush}" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}"
                                ToolTip="Agrandir" Click="MaximizeButton_Click">
                            <Path x:Name="MaximizeIcon" Data="{StaticResource CaptionMaximizeGeometry}"
                                  Width="10" Height="10" Stretch="None" StrokeThickness="1"
                                  Stroke="{StaticResource TextPrimaryBrush}" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButtonStyle}"
                                ToolTip="Fermer" Click="CloseButton_Click">
                            <Path Data="{StaticResource CaptionCloseGeometry}" Width="10" Height="10"
                                  Stretch="None" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{StaticResource TextPrimaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Shell à onglets (ui-design.md §Navigation). Comptes (Axe 3) + Raccourcis (Axe 5) + Paramètres (Axe 7). -->
            <TabControl Grid.Row="1" SelectionChanged="OnTabChanged">
                <TabItem Header="Comptes">
                    <views:AccountsView DataContext="{Binding Accounts}" />
                </TabItem>
                <TabItem Header="Raccourcis">
                    <views:ShortcutsView DataContext="{Binding Shortcuts}" />
                </TabItem>
                <TabItem x:Name="ReglagesTab" Header="Paramètres">
                    <views:ReglagesView DataContext="{Binding Settings}" />
                </TabItem>
            </TabControl>
        </Grid>
    </Border>

</Window>
